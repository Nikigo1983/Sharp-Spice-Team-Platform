# Supabase — база для задач, чата, AI-истории, заметок
# Project URL: Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# service_role key — только на сервере / Vercel, НЕ в браузере
SUPABASE_SERVICE_ROLE_KEY=

# Emigrant Croatia Desk — статусы дел клиентов для AI Workspace
# Supabase проекта https://emigrant-croatia-desk.vercel.app (отдельный от платформы)
EMIGRANT_SUPABASE_URL=
EMIGRANT_SUPABASE_SERVICE_ROLE_KEY=

# Auth — обязательно перед production
# AUTH_SECRET: случайная строка 32+ символов (openssl rand -base64 32)
AUTH_SECRET=change-me-to-a-long-random-string
# Пароли сотрудников. Можно plain text или bcrypt-хеш (npm run auth:hash-password -- "ваш-пароль")
AUTH_PASSWORD_VERONIKA=veronika-dev
AUTH_PASSWORD_MANAGER_1=manager1-dev
AUTH_PASSWORD_MANAGER_2=manager2-dev
AUTH_PASSWORD_MANAGER_3=manager3-dev
# Google Sheets — CRM клиентов (без переменных — демо-данные)
GOOGLE_SHEETS_SPREADSHEET_ID=

# Хорватия: ответы анкеты Formgrid (раздел «Эмиграция»)
# GOOGLE_SHEETS_SPREADSHEET_ID=1S8Y0VCaAQ78wxg5Rxl8fcFMkwSsvr-X-cLrAlK4nF9Q
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_CLIENTS_RANGE=Clients!A1:Z2000

# Клиенты Хорватия (таблица "Клиенты Хорватия.xlsx") — читаем публично без service account.
# Нужен только GID вкладки (gid в ссылке вида .../edit?gid=143...#gid=143...).
# Если service account настроен — используется Sheets API с range'ами выше.
GOOGLE_SHEETS_PUBLIC_CLIENTS_GID=

# Formgrid: новые клиенты из анкеты (новый раздел на платформе)
GOOGLE_SHEETS_FORMGRID_SPREADSHEET_ID=1S8Y0VCaAQ78wxg5Rxl8fcFMkwSsvr-X-cLrAlK4nF9Q
GOOGLE_SHEETS_FORMGRID_GID=0

GOOGLE_SHEETS_FORMS_RANGE=Forms!A1:Z2000
GOOGLE_SHEETS_DOCUMENTS_RANGE=Documents!A1:Z2000
GOOGLE_SHEETS_NOTES_RANGE=Notes!A1:E5000
GOOGLE_SHEETS_CACHE_TTL_MS=10000

# Knowledge Base — папка Google Drive (расшарить на service account)
GOOGLE_DRIVE_KB_FOLDER_ID=

# AI — OpenRouter (рекомендуется) или прямой OpenAI
# Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Бесплатные: meta-llama/llama-3.3-70b-instruct:free , openrouter/free
# Платные: openai/gpt-4o-mini , anthropic/claude-3.5-haiku
OPENROUTER_MODEL=openrouter/free
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=Sharp & Spice Team Platform

# AI Workspace — стиль и модель ответов
AI_WORKSPACE_MODEL=openai/gpt-4o
AI_WORKSPACE_TEMPERATURE=0.8
AI_WORKSPACE_MAX_TOKENS=1000
AI_WORKSPACE_STREAM=true

# Альтернатива — только если не используете OpenRouter
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
